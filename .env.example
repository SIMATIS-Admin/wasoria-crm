# Copier ce fichier en .env (jamais commité) puis renseigner les valeurs.
# Base locale (compose.yaml) : mot de passe hexadécimal, sans caractère spécial (openssl rand -hex 24)
POSTGRES_PASSWORD=
DB_PORT=
# postgres://wasoria:<POSTGRES_PASSWORD>@localhost:<DB_PORT>/wasoria
DATABASE_URL=
# Jeton exigé par l'API, 24 caractères minimum : openssl rand -hex 24
API_TOKEN=
PORT=
# Écritures réelles vers Odoo et l'OS : off par défaut, on pour les activer
REAL_WRITES=
