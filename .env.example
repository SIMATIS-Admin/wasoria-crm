# Copier ce fichier en .env (jamais commité) puis renseigner les valeurs.
# Base locale (compose.yaml) : mot de passe hexadécimal, sans caractère spécial (openssl rand -hex 24)
POSTGRES_PASSWORD=
DB_PORT=
# postgres://wasoria:<POSTGRES_PASSWORD>@localhost:<DB_PORT>/wasoria
DATABASE_URL=
# Jeton des intégrations (OS, scripts) et clé du premier compte, 24 caractères minimum : openssl rand -hex 24
API_TOKEN=
# on derrière un proxy https (cookie Secure, adresse réelle du client), sinon vide
TRUST_PROXY=
PORT=
# Écritures réelles vers Odoo et l'OS : off par défaut, on pour les activer
REAL_WRITES=

# Odoo (facultatif, lecture seule). Vide = pas de synchronisation.
ODOO_URL=
# json2 (Odoo 19 et suivants) ou jsonrpc (Odoo 17 et 18)
ODOO_PROTOCOL=
# Obligatoires en jsonrpc, facultatives en json2 (base)
ODOO_DB=
ODOO_LOGIN=
ODOO_API_KEY=
# Champs à ne jamais copier, séparés par des virgules (ex. contact.telephone,contact.email)
ODOO_CHAMPS_EXCLUS=
# Mode démonstration : un bouton « Démo » recharge un scénario fictif en EFFAÇANT les données (on / vide)
DEMO_MODE=
